{
    "name": "redberryproducts/laravel-bog-payment",
    "description": "This is my package bog-payment",
    "keywords": [
        "redberryproducts",
        "laravel",
        "bog-payment"
    ],
    "homepage": "https://github.com/RedberryProducts/laravel-bog-payment",
    "license": "MIT",
    "authors": [
        {
            "name": "Nika Jorjoliani",
            "email": "nika@redberry.ge",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "RedberryProducts\\LaravelBogPayment\\": "src/",
            "RedberryProducts\\LaravelBogPayment\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RedberryProducts\\LaravelBogPayment\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-bog-payment --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RedberryProducts\\LaravelBogPayment\\BogPaymentServiceProvider"
            ],
            "aliases": {
                "BogPayment": "RedberryProducts\\LaravelBogPayment\\Facades\\BogPayment"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
